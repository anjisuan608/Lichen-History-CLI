{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Bash-like history command management for Minecraft.",
  "authors": [
    {
      "name": "${mod_authors}",
      "contact": {
        "sources": "https://github.com/anjisuan608/Lichen-History-CLI"
      }
    }
  ],
  "credits": "${mod_credits}",
  "license": "${mod_license}",
  "icon": "assets/lichenhistorycli/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.anjisuan608.historycli.fabric.HistoryCliFabric"
    ],
    "client": [
      "org.anjisuan608.historycli.fabric.client.HistoryCliFabricClient"
    ],
    "modmenu": [
      "org.anjisuan608.historycli.fabric.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "lichenhistorycli.mixins.json",
    {
      "config": "lichenhistorycli.client.mixins.json",
      "environment": "client"
    },
    {
      "config": "lichenhistorycli.server.mixins.json",
      "environment": "server"
    }
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
